{
  "name": "wso-react",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@reduxjs/toolkit": "^1.8.3",
    "axios": "^0.34.0",
    "classnames": "^2.3.1",
    "dayjs": "^1.10.7",
    "dom-to-image": "^2.6.0",
    "google-client-api": "^1.0.4",
    "jwt-decode": "^3.1.2",
    "markdown-to-jsx": "^7.7.4",
    "prop-types": "^15.8.1",
    "react": "^16.8.6",
    "react-date-picker": "^7.8.1",
    "react-dom": "^16.8.6",
    "react-ga": "^2.7.0",
    "react-google-charts": "^3.0.14",
    "react-icons": "^3.10.0",
    "react-modal": "^3.15.1",
    "react-redux": "^7.2.8",
    "react-router-dom": "6",
    "react-spinners": "^0.13.4",
    "react-table": "^7.8.0",
    "redux-persist": "^6.0.0",
    "redux-saga": "^1.0.5",
    "serialize-javascript": "7.1.3",
    "timeago.js": "^4.0.0-beta.2",
    "typeface-source-sans-pro": "^0.0.75",
    "wso-api-client": "git+https://github.com/WilliamsStudentsOnline/wso-api-client.git#v2026.11.13-2"
  },
  "devDependencies": {
    "@size-limit/file": "^12.1.0",
    "@types/react": "^16.14.29",
    "@types/react-calendar": "^3.9.0",
    "@types/react-dom": "^16.9.16",
    "@types/redux-logger": "^3.0.9",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-react": "^6.3.0",
    "deep-freeze": "^0.0.1",
    "eslint": "^8.21.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^8.5.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-utils": "3.0.0",
    "glob-all": "^3.3.0",
    "husky": "^8.0.1",
    "identity-obj-proxy": "^3.0.0",
    "jsdom": "^31.0.1",
    "lint-staged": "^13.0.3",
    "prettier": "^2.7.1",
    "purgecss": "^1.4.1",
    "react-test-renderer": "^16.8.6",
    "redux-logger": "^3.0.6",
    "rollup-plugin-visualizer": "^7.1.3",
    "size-limit": "^12.1.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "scripts": {
    "analyze": "vite build --mode analyze",
    "start": "vite",
    "build": "tsc && vite build",
    "postbuild": "purgecss --config ./purgecss.config.js --out build/assets",
    "test": "vitest",
    "test:ci": "vitest run",
    "lint": "eslint ./src --ext=js,jsx,ts,tsx",
    "lint:fix": "eslint ./src --ext=js,jsx,ts,tsx --fix",
    "format": "prettier --write './src/**/*.{js,jsx,ts,tsx,html,css,json}'",
    "format:check": "prettier --write './src/**/*.{js,jsx,ts,tsx,html,css,json}'",
    "size": "size-limit",
    "prepare": "husky install",
    "sync-prod": "bash .github/scripts/open-sync-prod.sh",
    "check-prod-integrity": "bash .github/scripts/check-prod-integrity.sh",
    "codegen": "node scripts/codegen.mjs",
    "preview": "vite preview"
  },
  "size-limit": [
    {
      "name": "JS",
      "path": "build/assets/*.js",
      "limit": "300 kB"
    },
    {
      "name": "CSS",
      "path": "build/assets/*.css",
      "limit": "40 kB"
    }
  ],
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --ext=js,jsx,ts,tsx --fix",
      "prettier --write"
    ],
    "*.{html,css,json}": [
      "prettier --write"
    ]
  },
  "resolutions": {
    "axios": "^0.34.0",
    "**/**/dot-prop": ">=5.2.0",
    "**/**/elliptic": ">=6.5.3",
    "**/**/kind-of": ">=6.0.3",
    "**/**/minimist": ">=1.2.2",
    "**/**/object-path": ">=0.11.5",
    "**/**/node-forge": ">=0.10.0",
    "**/**/node-notifier": ">=8.0.1",
    "**/**/immer": ">=8.0.1",
    "@types/react": "^16.14.29",
    "@types/react-dom": "^16.9.16",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@typescript-eslint/type-utils": "^5.62.0",
    "@typescript-eslint/typescript-estree": "^5.62.0"
  }
}
